{
  "name": "pi-web",
  "version": "0.1.0",
  "description": "Browser GUI for the pi coding agent (runs pi in RPC mode, no npm dependencies)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "pi-web": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs --open",
    "test": "node test/unit.mjs && node test/server-auth.mjs && node test/e2e.mjs",
    "test:real": "node test/real-pi.mjs",
    "test:real:prompt": "node test/real-pi.mjs --prompt",
    "start:real": "node test/real-server.mjs",
    "start:remote": "node server.mjs --remote"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
